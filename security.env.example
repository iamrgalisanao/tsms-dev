# Security Monitoring Configuration
SECURITY_MONITORING_ENABLED=true
SECURITY_LOG_CHANNEL=security
SECURITY_REDIS_PREFIX=security:

# Login Security
SECURITY_MAX_LOGIN_ATTEMPTS=5
SECURITY_LOGIN_DECAY_MINUTES=15

# Alert Configuration
SECURITY_ALERT_EMAIL_ENABLED=true
SECURITY_ALERT_EMAIL_RECIPIENTS=admin@example.com
SECURITY_ALERT_SLACK_ENABLED=false
SECURITY_ALERT_SLACK_WEBHOOK=

# Event Settings
SECURITY_EVENT_RETENTION_DAYS=90

# Security Integration Settings
SECURITY_CIRCUIT_BREAKER_THRESHOLD=10
SECURITY_CIRCUIT_BREAKER_COOLDOWN=30
SECURITY_RATE_LIMIT_MAX=100
SECURITY_RATE_LIMIT_DECAY=1

# License Redeployment Control
LICENSE_ENABLED=true
LICENSE_ENFORCEMENT_MODE=observe
LICENSE_CLIENT_ID=
LICENSE_DEPLOYMENT_ID=
LICENSE_ID=
LICENSE_LOCATION_CODE=
LICENSE_ENVIRONMENT=production
LICENSE_FILE_PATH=storage/app/private/license.json
LICENSE_PUBLIC_KEY_PATH=storage/app/private/license_public.key
LICENSE_APPROVED_SERVER_IDENTIFIER=
LICENSE_HARD_BLOCK_ON_SOFT_INPUT_CHANGE=false
LICENSE_STATUS_CACHE_TTL_SECONDS=30
LICENSE_AUDIT_SUCCESSES=false
LICENSE_VENDOR_AUTHORITY_ROLES=vendor,vendor_support,license_manager
LICENSE_VENDOR_MANAGE_PERMISSION=license.manage
LICENSE_VENDOR_VIEW_PERMISSION=license.view
LICENSE_VENDOR_UPLOAD_PERMISSION=license.upload
LICENSE_VENDOR_RECOVERY_PERMISSION=license.recovery.request
