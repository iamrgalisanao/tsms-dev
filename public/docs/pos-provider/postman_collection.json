{
  "info": {
    "name": "TSMS POS Provider API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://salesportal.pitx.com.ph/api/v1"
    },
    {
      "key": "token",
      "value": "{provider_testing_token}"
    },
    {
      "key": "submission_uuid",
      "value": "{submission_uuid}"
    }
  ],
  "item": [
    {
      "name": "Authenticate Terminal",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/terminal",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"serial_number\": \"TERM-001\",\n  \"api_key\": \"replace-with-terminal-api-key\"\n}"
        }
      }
    },
    {
      "name": "Submit Official Transaction",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/transactions/official",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"submission_uuid\": \"{{submission_uuid}}\",\n  \"tenant_id\": 28,\n  \"terminal_id\": 31,\n  \"submission_timestamp\": \"2026-06-13T13:25:45Z\",\n  \"transaction_count\": 1,\n  \"payload_checksum\": \"replace-with-64-char-sha256\",\n  \"transaction\": {\n    \"transaction_id\": \"fc3b0759-d617-487d-9463-1e6d6e5a7985\",\n    \"hardware_id\": \"TERM-001\",\n    \"receipt_no\": \"0000017336\",\n    \"transaction_timestamp\": \"2026-06-13T13:00:44Z\",\n    \"gross_sales\": \"90.00\",\n    \"net_sales\": \"90.00\",\n    \"promo_status\": \"WITH_APPROVAL\",\n    \"customer_code\": \"C-C1036\",\n    \"payload_checksum\": \"replace-with-64-char-sha256\",\n    \"adjustments\": [\n      { \"adjustment_type\": \"promo_discount\", \"amount\": \"0.00\" },\n      { \"adjustment_type\": \"senior_discount\", \"amount\": \"0.00\" },\n      { \"adjustment_type\": \"pwd_discount\", \"amount\": \"0.00\" },\n      { \"adjustment_type\": \"vip_card_discount\", \"amount\": \"0.00\" },\n      { \"adjustment_type\": \"service_charge_distributed_to_employees\", \"amount\": \"0.00\" },\n      { \"adjustment_type\": \"service_charge_retained_by_management\", \"amount\": \"0.00\" },\n      { \"adjustment_type\": \"employee_discount\", \"amount\": \"0.00\" }\n    ],\n    \"taxes\": [\n      { \"tax_type\": \"VAT\", \"amount\": \"9.64\" },\n      { \"tax_type\": \"VATABLE_SALES\", \"amount\": \"80.36\" },\n      { \"tax_type\": \"SC_VAT_EXEMPT_SALES\", \"amount\": \"0.00\" },\n      { \"tax_type\": \"OTHER_TAX\", \"amount\": \"0.00\" }\n    ]\n  }\n}"
        }
      },
      "response": [
        {
          "name": "200 Accepted and Queued",
          "originalRequest": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/transactions/official"
          },
          "status": "OK",
          "code": 200,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"success\": true,\n  \"message\": \"Official submission processed: 1 successful, 0 failed\",\n  \"data\": {\n    \"submission_uuid\": \"{{submission_uuid}}\",\n    \"processed_count\": 1,\n    \"failed_count\": 0,\n    \"checksum_validation\": \"passed\",\n    \"transactions\": [\n      {\n        \"transaction_id\": \"fc3b0759-d617-487d-9463-1e6d6e5a7985\",\n        \"status\": \"queued\",\n        \"message\": \"Transaction queued for processing\"\n      }\n    ]\n  }\n}"
        },
        {
          "name": "429 Too Many Requests",
          "originalRequest": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/transactions/official"
          },
          "status": "Too Many Requests",
          "code": 429,
          "header": [
            {
              "key": "Retry-After",
              "value": "42"
            },
            {
              "key": "X-RateLimit-Limit",
              "value": "120"
            },
            {
              "key": "X-RateLimit-Remaining",
              "value": "0"
            }
          ],
          "body": "{\n  \"success\": false,\n  \"message\": \"Too many requests.\",\n  \"retry_after\": 42\n}"
        }
      ]
    },
    {
      "name": "Submission Status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{base_url}}/submissions/{{submission_uuid}}"
      }
    },
    {
      "name": "Transaction Status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{base_url}}/transactions/fc3b0759-d617-487d-9463-1e6d6e5a7985/status",
        "description": "Top-level status/success indicates the lookup request succeeded. data.status and data.processing_status indicate the transaction processing state."
      },
      "response": [
        {
          "name": "200 Lookup Succeeded - Queued",
          "originalRequest": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/transactions/fc3b0759-d617-487d-9463-1e6d6e5a7985/status"
          },
          "status": "OK",
          "code": 200,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"success\": true,\n  \"status\": \"success\",\n  \"message\": \"Status lookup succeeded\",\n  \"data\": {\n    \"transaction_id\": \"fc3b0759-d617-487d-9463-1e6d6e5a7985\",\n    \"customer_code\": \"C-C1036\",\n    \"gross_sales\": \"90.00\",\n    \"net_sales\": \"90.00\",\n    \"status\": \"queued\",\n    \"processing_status\": \"queued\",\n    \"job_status\": \"QUEUED\",\n    \"validation_status\": \"PENDING\",\n    \"completed_at\": null,\n    \"attempts\": 0,\n    \"error\": null,\n    \"created_at\": \"2026-06-13T13:25:45.000000Z\",\n    \"updated_at\": \"2026-06-13T13:25:45.000000Z\"\n  }\n}"
        }
      ]
    },
    {
      "name": "Heartbeat",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{base_url}}/heartbeat"
      }
    }
  ]
}
